# Copy this file to .env and fill only the providers you use.

# Optional provider selector. CLI --provider still takes precedence.
ELLIE_PROVIDER=deepseek

# Recommended default. DeepSeek uses its Anthropic-compatible endpoint.
ELLIE_DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
ELLIE_DEEPSEEK_API_KEY=
ELLIE_DEEPSEEK_MODEL=deepseek-v4-pro

# Default OpenAI-compatible endpoint. Change this if you use another /responses-compatible service.
ELLIE_OPENAI_API_BASE=https://api.openai.com/v1
ELLIE_OPENAI_API_KEY=
ELLIE_OPENAI_MODEL=gpt-5.4

# Default Anthropic-compatible endpoint.
ELLIE_ANTHROPIC_API_BASE=https://api.anthropic.com
ELLIE_ANTHROPIC_API_KEY=
ELLIE_ANTHROPIC_MODEL=claude-sonnet-4-6

# vLLM / OpenAI Chat Completions-compatible backend (e.g. AutoDL, your own GPU server).
# Uses /v1/chat/completions — different from the --provider ellie /responses path.
ELLIE_VLLM_API_BASE=http://127.0.0.1:6006
ELLIE_VLLM_API_KEY=
ELLIE_VLLM_MODEL=Qwen2.5-7B-AWQ

# Optional comma-separated extra env names to redact from traces and reports.
ELLIE_SECRET_ENV_NAMES=
